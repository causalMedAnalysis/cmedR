Package: cmedR
Title: Causal Mediation Analysis
Version: 0.1.1
Authors@R: c(
    person("Geoffrey T.", "Wodtke", email = "wodtke@uchicago.edu", role = c("cre", "aut")),
	person("Xiang", "Zhou", email = "xiang_zhou@fas.harvard.edu", role = "aut"),
    person("Azim", "Shivji", email = "ashivji@gmail.com", role = "aut"),
    person("Jesse", "Zhou", email = "jessezhou1@uchicago.edu", role = "aut"),
    person("Weiqi", "Wang", email = "weiqiw@uchicago.edu", role = "aut"),
